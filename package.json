{
  "name": "next-js-boilerplate",
  "version": "3.66.0",
  "author": "Ixartz (https://github.com/ixartz)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:spotlight": "spotlight-sidecar",
    "dev:next": "next dev --turbo",
    "dev": "run-p dev:*",
    "build": "next build",
    "pages-build": "next-on-pages",
    "postinstall": "npm rebuild sharp --verbose && npm rebuild lightningcss --verbose",
    "start": "next start",
    "clean": "rimraf .next out coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit --pretty",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "commit": "cz",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c production -- drizzle-kit migrate",
    "db:studio": "dotenv -c production -- drizzle-kit studio",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:serve": "http-server storybook-static --port 6006 --silent",
    "serve-storybook": "run-s storybook:*",
    "test-storybook:ci": "start-server-and-test serve-storybook http://127.0.0.1:6006 test-storybook",
    "prepare": "[ \"$HUSKY\" != \"0\" ] && husky || echo 'Husky skipped'"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@hookform/resolvers": "4.1.3",
    "@logtail/pino": "0.5.2",
    "@mui/material": "7.0.2",
    "@rive-app/react-canvas": "4.21.4",
    "@sentry/nextjs": "8.55.0",
    "@spotlightjs/spotlight": "2.12.0",
    "@strapi/blocks-react-renderer": "1.0.2",
    "@t3-oss/env-nextjs": "0.12.0",
    "@tailwindcss/postcss": "4.0.17",
    "@tanstack/react-query": "^5.83.0",
    "autoprefixer": "10.4.21",
    "axios": "^1.10.0",
    "drizzle-orm": "0.41.0",
    "formik": "2.4.6",
    "framer-motion": "12.18.1",
    "gsap": "3.13.0",
    "jspdf": "^3.0.1",
    "lottie-react": "2.4.1",
    "lucide-react": "0.516.0",
    "next": "15.3.1",
    "next-intl": "3.26.5",
    "pg": "8.14.1",
    "pino": "9.6.0",
    "pino-pretty": "13.0.0",
    "posthog-js": "1.233.1",
    "react": "19.0.0",
    "react-countup": "6.5.3",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "react-icons": "5.5.0",
    "react-loading-skeleton": "3.5.0",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "swiper": "11.2.10",
    "tailwindcss": "4.1.8",
    "yup": "1.6.1",
    "zod": "3.24.2"
  },
  "optionalDependencies": {
    "@img/sharp-linuxmusl-x64": "0.33.5",
    "@tailwindcss/oxide-linux-x64-gnu": "4.1.8",
    "@tailwindcss/oxide-linux-x64-musl": "4.1.8",
    "lightningcss-linux-x64-gnu": "1.29",
    "lightningcss-linux-x64-musl": "1.29"
  },
  "devDependencies": {
    "@antfu/eslint-config": "4.11.0",
    "@cloudflare/next-on-pages": "1.13.12",
    "@commitlint/cli": "19.8.0",
    "@commitlint/config-conventional": "19.8.0",
    "@commitlint/cz-commitlint": "19.8.0",
    "@eslint-react/eslint-plugin": "1.38.0",
    "@faker-js/faker": "9.6.0",
    "@next/bundle-analyzer": "15.3.1",
    "@next/eslint-plugin-next": "15.2.4",
    "@percy/cli": "1.30.7",
    "@percy/playwright": "1.0.7",
    "@playwright/test": "1.51.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@storybook/addon-essentials": "8.6.10",
    "@storybook/addon-interactions": "8.6.10",
    "@storybook/addon-links": "8.6.10",
    "@storybook/addon-onboarding": "8.6.10",
    "@storybook/blocks": "8.6.10",
    "@storybook/nextjs": "8.6.10",
    "@storybook/react": "8.6.10",
    "@storybook/test": "8.6.10",
    "@storybook/test-runner": "0.22.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.13.13",
    "@types/pg": "8.11.11",
    "@types/qs": "^6.14.0",
    "@types/react": "19.0.12",
    "@types/react-icons": "3.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.0.9",
    "@vitest/expect": "3.0.9",
    "checkly": "5.1.0",
    "commitizen": "4.3.1",
    "cross-env": "7.0.3",
    "daisyui": "5.0.35",
    "dotenv-cli": "8.0.0",
    "drizzle-kit": "0.30.5",
    "eslint": "9.23.0",
    "eslint-plugin-format": "1.0.1",
    "eslint-plugin-jest-dom": "5.5.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.2.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "eslint-plugin-testing-library": "7.1.1",
    "http-server": "14.1.1",
    "husky": "9.1.7",
    "jsdom": "26.0.0",
    "lint-staged": "15.5.0",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.4",
    "postcss-load-config": "6.0.1",
    "rimraf": "6.0.1",
    "semantic-release": "24.2.3",
    "start-server-and-test": "2.0.11",
    "storybook": "8.6.10",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.0.9",
    "vitest-fail-on-console": "0.7.1",
    "wrangler": "4.13.0"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  }
}
