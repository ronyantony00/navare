# Git LFS tracking — Innogenio org policy.
# Large binaries are stored in Hetzner Object Storage, not in Git itself.
# Applies only to files committed AFTER this file; run `git lfs install` once
# per machine or tracked files will arrive as small text pointers.

# design source
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.ai filter=lfs diff=lfs merge=lfs -text
*.sketch filter=lfs diff=lfs merge=lfs -text
*.fig filter=lfs diff=lfs merge=lfs -text
